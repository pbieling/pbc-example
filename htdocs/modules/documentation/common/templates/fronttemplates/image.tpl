[image_standard]
<div class="pbc-docimage pbc-docimage-standard"><img src="{HTTP_PATH}"  alt="{IMGALT}"></div>

[image_author_floatleft]
<div class="pbc-docimage pbc-docimage_left img_with_author float-left"><img src="{HTTP_PATH}" alt="{IMGALT}">
    <p class="pbc-docimg_author">{AUTHOR}</p>
</div>

[image_author_description_floatleft]
<div class="blogimg_with_author float-left"><img src="{HTTP_PATH}" alt="">
    <p class="pbc-docimage_author">{AUTHOR}</p>
    <p class="pbc-docimage_description">{IMGDESCR}</p>
</div>

[image_description_floatleft]
<div class="pbc-docimage pbc-docimage-descripiton float-left"><img src="{HTTP_PATH}" alt="" class="img-responsive img-rounded">
    <p class="pbc-docimage_description">{IMGDESCR}</p>
</div>

[image_author_floatright]
<div class="blogimg_with_author pb-floatright"><img src="{HTTP_PATH}" alt="" class="img-responsive img-rounded">
    <p class="blogimg-author">{AUTHOR}</p>
</div>

[image_description_floatright]
<div class="blogimg_with_author pb-floatright"><img src="{HTTP_PATH}" alt="" class="img-responsive img-rounded">
    <p class="blogimg-description">{IMGDESCR}</p>
</div>

[image_author_description_floatright]
<div class="blogimg_with_author pb-floatright"><img src="{HTTP_PATH}" alt="" class="img-responsive img-rounded">
    <p class="blogimg-author">{AUTHOR}</p>
    <p class="blogimg-description">{IMGDESCR}</p>
</div>
