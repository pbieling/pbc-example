[ins_Nextrun]
<div class="form-group"><label for="{FIELD_NAME}">{FIELD_LABEL}</label>
      <div class="pbtable-btn-input-datetime btn-toolbar" data-fieldid="{FIELD_NAME}">
  <button type="button" class="btn btn-primary" value="0">jetzt</button>
  <button type="button" class="btn btn-primary" value="5">in 5 Min</button>
  <button type="button" class="btn btn-primary" value="10">in 10 Min</button>
  <button type="button" class="btn btn-primary" value="15">in 15 Min</button>
  <button type="button" class="btn btn-primary" value="30">in 30 Min</button>
  <button type="button" class="btn btn-primary" value="60">in 1 Std.</button>
</div>    
    
    
    <input type="hidden" id="{FIELD_NAME}" name="{FIELD_NAME}" value="{FIELD_VALUE}"><br>
    <input type="date" class="pbtable-datetime" id="{FIELD_NAME}_PARTDATE" value="{FIELD_VALUE_PARTDATE}" data-inpid="{FIELD_NAME}" required>
    <input type="time" class="pbtable-datetime" id="{FIELD_NAME}_PARTTIME" value="{FIELD_VALUE_PARTTIME}" data-inpid="{FIELD_NAME}" required></div>


    
    
    
