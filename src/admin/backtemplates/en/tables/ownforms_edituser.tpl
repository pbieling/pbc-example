[upd_ON_OFF]
<div class="form-group">
<label for="{FIELD_NAME}">{FIELD_LABEL}</label>
<p id="{FIELD_NAME}-oldvalue">{FIELD_VALUE}</p>
<p><select type="text" class="form-control" id="{FIELD_NAME}" name="{FIELD_NAME}">{OPTIONS}</select></p>
</div>

[upd_Passw]
