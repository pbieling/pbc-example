<label for="{FIELD_NAME}">{FIELD_LABEL}</label>
<p id="{FIELD_NAME}-oldvalue" class="oldvalue">{FIELD_VALUE}</p>
<input type="text" class="form-control" id="{FIELD_NAME}" name="{FIELD_NAME}" value="" maxlength="{FIELD_MAXLENGTH}">
</div>

