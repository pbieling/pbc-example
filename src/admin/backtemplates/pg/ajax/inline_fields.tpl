[standard_input]
<div class="form-group">
  <label for="pbpg-inlinefield-{IDENTIFYER}">{LABEL}:</label>
  <input type="text" id="pbpg-inlinefield-{IDENTIFYER}"  name="pbpg-inlinefield[{IDENTIFYER}]" class="form-control pbpg-inlinefield" data-id="{IDENTIFYER}">
</div>

[small_textarea]
 <div class="form-group">
  <label for="pbpg-inlinefield-{IDENTIFYER}">{LABEL}:</label>
  <textarea class="form-control" rows="3" id="pbpg-inlinefield-{IDENTIFYER}" name="pbpg-inlinefield[{IDENTIFYER}]"  data-id="{IDENTIFYER}"></textarea>
</div> 


[no_fields]
<p><i>Keine zusätzlichen Eingabefelder hinterlegt</i></p>
